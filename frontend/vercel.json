{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=home"
    },
    {
      "source": "/varistorehn",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=home"
    },
    {
      "source": "/varistorehn/productos",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=products"
    },
    {
      "source": "/varistorehn/ofertas",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=offers"
    },
    {
      "source": "/varistorehn/categorias",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=categories"
    },
    {
      "source": "/varistorehn/categoria/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=category&slug=:slug"
    },
    {
      "source": "/varistorehn/producto/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|googlebot|Bingbot|bingbot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot).*"
        }
      ],
      "destination": "/api/seo?kind=product&slug=:slug"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "varistorehn.vercel.app"
        }
      ],
      "destination": "https://variapp-api.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://variapp-api-desarrollo.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
