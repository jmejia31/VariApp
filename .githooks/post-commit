#!/usr/bin/env sh

EXPECTED_REPO="jmejia31/VariApp"
branch="$(git branch --show-current 2>/dev/null)"

if [ "$branch" != "Desarrollo" ]; then
  echo "[VariApp] Commit local creado en '$branch'. No se realizará push automático." >&2
  echo "[VariApp] La rama oficial es 'Desarrollo'. Revisa el contexto antes de continuar." >&2
  exit 0
fi

origin_url="$(git remote get-url origin 2>/dev/null)"
case "$origin_url" in
  "https://github.com/jmejia31/VariApp"|"https://github.com/jmejia31/VariApp.git"|"git@github.com:jmejia31/VariApp.git"|"ssh://git@github.com/jmejia31/VariApp.git") ;;
  *)
    echo "[VariApp] BLOQUEADO: origin='$origin_url' no corresponde a $EXPECTED_REPO." >&2
    echo "[VariApp] No se realizó ningún push. Verifica que no estés en otro proyecto." >&2
    exit 0
    ;;
esac

echo "[VariApp] Publicando el commit en origin/Desarrollo..."

if git push origin Desarrollo; then
  echo "[VariApp] GitHub quedó actualizado correctamente."
else
  echo "[VariApp] No fue posible publicar el commit automáticamente." >&2
  echo "[VariApp] El commit permanece seguro en local. Reintenta con: git push origin Desarrollo" >&2
  exit 0
fi
