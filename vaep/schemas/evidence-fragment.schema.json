{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variapp.local/schemas/evidence-fragment.schema.json",
  "title": "VariApp VAEP evidence fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "parentId", "worker", "dispatchId", "baseHead", "resultHead", "status", "evidence", "tests", "workflows", "artifacts", "p0", "p1", "timestamp", "blockers", "attempt", "fileScope", "notes"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "parentId": {"type": "string", "pattern": "^N[0-9]+\\.[0-9]+\\.[A-H]$"},
    "worker": {"type": "string", "minLength": 1},
    "dispatchId": {"type": "string", "minLength": 8},
    "baseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "resultHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"type": "string", "enum": ["SUCCESS", "PASS", "FAILURE", "BLOCKED", "PENDING", "LISTO_REAL"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "workflows": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "p0": {"type": "integer", "minimum": 0},
    "p1": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "fileScope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
