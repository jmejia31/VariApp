{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variapp.local/schemas/jules-dispatch.schema.json",
  "title": "VariApp VAEP Jules dispatch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "repository", "branch", "dispatchId", "taskId", "parentId", "phase", "stage", "primaryBaseHead", "fileScopeHint", "worker", "attempt", "attemptConsumed", "dependencies", "acceptanceCriteria", "tracks", "session", "ownership", "timestamps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"const": "VARIAPP"},
    "repository": {"const": "jmejia31/VariApp"},
    "branch": {"const": "Desarrollo"},
    "dispatchId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "taskId": {"type": "string", "pattern": "^N[0-9]+\\.[0-9]+\\.[A-H](\\.[A-Za-z0-9._-]+)*$"},
    "parentId": {"type": "string", "pattern": "^N[0-9]+\\.[0-9]+\\.[A-H]$"},
    "phase": {"type": "string", "enum": ["PRE", "DOMAIN", "DB_MIG", "BACKEND_API", "FRONTEND_UX", "SEC_AUDIT", "TEST_CI", "DOC_CERT"]},
    "stage": {"type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
    "primaryBaseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileScopeHint": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*(^|/)(main|Produccion)(/|$)).+$"}},
    "worker": {"type": "string", "enum": ["JULES_A", "JULES_B", "JULES_C", "JULES_D", "CODEX", "CHATGPT_VAEP"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "attemptConsumed": {"const": false},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["taskId", "status"], "properties": {"taskId": {"type": "string"}, "status": {"type": "string", "enum": ["SATISFIED", "BLOCKED", "PENDING"]}}}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tracks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "session": {"type": "object", "additionalProperties": false, "required": ["sessionId", "workerId", "correlationId"], "properties": {"sessionId": {"type": "string", "minLength": 1}, "workerId": {"type": "string", "minLength": 1}, "correlationId": {"type": "string", "minLength": 1}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["owner", "status", "scopes"], "properties": {"owner": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["AVAILABLE", "RELEASED"]}, "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["createdAt"], "properties": {"createdAt": {"type": "string", "format": "date-time"}}}
  }
}
