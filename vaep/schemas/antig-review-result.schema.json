{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variapp.local/schemas/antig-review-result.schema.json",
  "title": "VariApp AntiG automated review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","projectId","repository","branch","issueNumber","taskId","parentId","dispatchId","taskAttempt","decision","readyForVaep","scopeAssessment","summary","filesChanged","validations","p0","p1","blockers"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "projectId": {"const": "VARIAPP"},
    "repository": {"const": "jmejia31/VariApp"},
    "branch": {"const": "Desarrollo"},
    "issueNumber": {"type": "integer", "minimum": 1},
    "taskId": {"type": "string", "minLength": 1},
    "parentId": {"type": "string", "pattern": "^N[0-9]+\\.[0-9]+\\.[A-H]$"},
    "dispatchId": {"type": "string", "minLength": 8},
    "taskAttempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "decision": {"type": "string", "enum": ["READY_FOR_VAEP","RETURN_TO_JULES","BLOCKED_QA_TAKEOVER","NO_ACTION"]},
    "readyForVaep": {"type": "boolean"},
    "scopeAssessment": {"type": "string", "enum": ["IN_SCOPE","SCOPE_LEAK","STALE_CONFLICT","INVALID_EVIDENCE"]},
    "summary": {"type": "string", "minLength": 1},
    "filesChanged": {"type": "array", "items": {"type": "string"}},
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name","status","command","notes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS","FAIL","SKIPPED"]},
          "command": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "p0": {"type": "integer", "minimum": 0},
    "p1": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
